name: Local CI/CD
on:
  push:
    branches: [ main ]

jobs:
  build-and-test:
    runs-on: ------------------
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Docker Compose
        run: docker compose up --build -d

      - name: Wait for DB
        run: sleep 5

      - name: Run Tests
        run: ./test.sh
